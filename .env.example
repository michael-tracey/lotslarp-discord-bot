# This file is used to store sensitive environment variables for your bot.
# DO NOT commit this file to version control.

# Discord Bot Token - Get this from the Discord Developer Portal
LOTSLARP_DISCORD_BOT_DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# Gemini API Key - Get this from the Google AI Studio
LOTSLARP_DISCORD_BOT_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Database Path
# For Cloud Run, you might want to use a persistent volume, e.g., /mnt/db/huh.db
LOTSLARP_DISCORD_BOT_APP_DB="/app/huh.db"

# Summary Role Name: The name of the role that, when @mentioned in a message, will cause that message to be included in the daily digest.
LOTSLARP_DISCORD_BOT_SUMMARY_ROLE_NAME="YOUR_SUMMARY_ROLE_NAME"

# Digest Channel ID: The ID of the Discord channel where the PDF digest will be sent.
LOTSLARP_DISCORD_BOT_DIGEST_CHANNEL_ID="YOUR_DIGEST_CHANNEL_ID"

# Gemini Model Name: The specific Gemini model to use for summaries.
# e.g., "gemini-1.5-flash" or "gemini-pro". The bot will list available models on startup.
LOTSLARP_DISCORD_BOT_GEMINI_MODEL="gemini-1.5-flash"

# Gemini Prompt Instructions: The instructions to send to the AI for generating summaries.
LOTSLARP_DISCORD_BOT_GEMINI_PROMPT="You are an AI assistant tasked with creating a high-level executive summary of Discord conversations. Analyze the following collection of messages and provide a concise summary. The summary should adhere to these rules: 1. Start with a one-sentence overview of the general topics discussed. 2. Use bullet points to highlight key decisions, action items, or significant points of interest. 3. Group related topics together under a common sub-heading if the conversation covers multiple distinct subjects. 4. Maintain a neutral, professional tone. 5. Do not invent or infer information that isn't present in the messages. 6. The summary should be no more than 4 paragraphs in total. Here are the messages to summarize:"

# Digest Cron Schedule: A cron string that defines how often the bot checks if a digest should be sent.
# Default is "0 * * * *", which means check every hour at minute 0.
# Format: Minute Hour Day-of-Month Month Day-of-Week
LOTSLARP_DISCORD_BOT_DIGEST_CRON="0 * * * *"

# Digest Max Messages: The number of accumulated messages that triggers an immediate digest send.
LOTSLARP_BOT_MAX_MESSAGES_BEFORE_DIGEST=10

# Digest Max Time: The maximum hours to wait before sending a digest, even if message count is low.
LOTSLARP_BOT_MAX_TIME_BEFORE_DIGEST=72

# Voice Report Channel ID: The ID of the Discord channel where voice activity reports will be sent.
LOTSLARP_BOT_VOICE_REPORT_CHANNEL_ID="YOUR_VOICE_REPORT_CHANNEL_ID"

# Bot Timezone: The timezone to use for reports (e.g., "America/New_York").
LOTSLARP_BOT_TIMEZONE="America/New_York"

# Channel Summary Output Channel ID: The ID of the Discord channel where /summarize command results will be posted.
LOTSLARP_BOT_SUMMARY_CHANNEL_ID="YOUR_SUMMARY_OUTPUT_CHANNEL_ID"

# Channel Summary Prompt (Optional): Custom prompt for channel summaries.
# If not set, a default prompt will be used.
LOTSLARP_DISCORD_BOT_CHANNEL_SUMMARY_PROMPT="You are an AI assistant tasked with creating a high-level executive summary of Discord conversations. Analyze the following collection of messages and provide a concise summary. The summary should adhere to these rules: 1. Start with a one-sentence overview of the general topics discussed. 2. Use bullet points to highlight key decisions, action items, or significant points of interest. 3. Group related topics together under a common sub-heading if the conversation covers multiple distinct subjects. 4. Maintain a neutral, professional tone. 5. Do not invent or infer information that isn't present in the messages. 6. The summary should be no more than 4 paragraphs in total. Here are the messages to summarize:"

# --- Summary Reminder Feature ---
# Admin role name that can trigger the /stale-channels command.
LOTSLARP_BOT_ADMIN_USER="@storytellers"

# Minimum number of messages in lookback period to consider a channel for reminder.
LOTSLARP_BOT_SUMMARY_REMINDER_MESSAGES_COUNT=3

# Number of days to look back for messages (and absence of summary).
LOTSLARP_BOT_SUMMARY_REMINDER_LOOKBACK_DAYS=90

# Number of days of inactivity required to trigger a reminder (no messages in last X days).
LOTSLARP_BOT_SUMMARY_REMINDER_ACTIVITY_DAYS=5

# Maximum number of channels to process/report in one run to avoid rate limits.
LOTSLARP_BOT_SUMMARY_THROTTLE_CHANNEL_COUNT=25

# Minimum number of words in a message to count it towards the summary reminder.
LOTSLARP_BOT_SUMMARY_REMINDER_MIN_WORDS=5

# Inactivity days after a bot reminder to consider a channel for archive.
LOTSLARP_BOT_ARCHIVE_REMINDER_INACTIVITY_DAYS=14

# Total inactivity days to consider a channel for archive.
LOTSLARP_BOT_ARCHIVE_INACTIVITY_DAYS=180

# Comma-separated list of role names to check for when determining if a summary has been requested.
# The bot will look for mentions of any of these roles.
LOTSLARP_BOT_SUMMARY_REMINDER_ROLE_NAMES="@Storytellers,@summary"

# Automated Stale Channel Check
# Cron schedule for the daily check. E.g. "0 10 * * *" (10 AM UTC)
LOTSLARP_BOT_STALE_CHANNELS_CRON="0 10 * * *"

# Comma-separated list of Guild IDs to ignore during the stale channel check.
LOTSLARP_BOT_STALE_CHANNELS_IGNORE_GUILDS=""

# --- New User Setup Feature ---
# The ID of the category where new user private channels will be created.
LOTSLARP_BOT_CREATE_NEW_USER_CATEGORY="1233865829985288233"

# The template for the first message sent in the new user's channel.
# Available placeholders: {user_mention}, {user_name}, {channel_mention}, {guild_name}
# You can use \n for newlines.
LOTSLARP_BOT_NEW_USER_MESSAGE_TEMPLATE="Welcome {user_mention}! :wave:\n\nThis is your **personal channel** with the Storytellers. Use this space to:\n• Discuss character concepts\n• Ask rule questions\n• Chat privately with staff\n\nWe'll rename this channel to your character's name once you're approved!\n\n(You can also email us at storytellers@lotslarp.org, but this channel is usually faster.)"

# Comma-separated list of additional roles to give read access to the new channel (e.g., utility bots).
LOTSLARP_BOT_NEW_USER_CHANNEL_ADDITIONAL_ROLES=Tupperbox,Carl-bot

# Map and Admin Settings
LOTSLARP_MAP_URL=https://your-map-url.a.run.app
LOTSLARP_ADMIN_PASSWORD=your-secure-password

# --- Monthly Summary Configuration ---
# The ordinal of the game week in the month (e.g., 1 for 1st, 2 for 2nd, -1 for last).
LOTSLARP_GAME_WEEK_ORDINAL=1

# The day of the week for the game (0=Monday, 6=Sunday). Default is 5 (Saturday).
LOTSLARP_GAME_WEEKDAY=5

# Custom prompt for the monthly summary (Optional).
LOTSLARP_DISCORD_BOT_MONTHLY_PROMPT="You are an AI assistant tasked with creating a comprehensive executive summary of Discord conversations from the past month. Analyze the following collection of messages and provide a detailed summary. The summary should adhere to these rules: 1. Start with a one-sentence overview of the general topics discussed. 2. Use bullet points to highlight key decisions, action items, or significant points of interest. 3. Group related topics together under a common sub-heading if the conversation covers multiple distinct subjects. 4. Maintain a neutral, professional tone. 5. Do not invent or infer information that isn't present in the messages. 6. The summary should be approximately 6-8 paragraphs in total to reflect the large volume of activity. Here are the messages to summarize:"



# Number of previous monthly summaries to include as context for the current one.

# Defaults to 3 if not set.

# Number of concurrent archives allowed.
LOTSLARP_MAX_CONCURRENT_ARCHIVES=2
DCE_CLI_PATH=/home/michael/bin/DiscordChatExport/DiscordChatExporter.Cli
LOTSLARP_ARCHIVE_RETENTION_DAYS=7
LOTSLARP_ARCHIVE_CHANNEL_ID=
LOTSLARP_BOT_SUMMARY_CHANNEL_ID=
LOTSLARP_ADMIN_PASSWORD=
