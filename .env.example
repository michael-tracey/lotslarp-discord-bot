# This is an example .env file.
# Copy this file to .env and fill in your secrets.
# Do not commit .env to version control.

# Discord Bot Token
LOTSLARP_DISCORD_BOT_DISCORD_TOKEN=""

# Gemini API Key
LOTSLARP_DISCORD_BOT_GEMINI_API_KEY=""

# SMTP Server Settings
LOTSLARP_DISCORD_BOT_SMTP_SERVER=""
LOTSLARP_DISCORD_BOT_SMTP_PORT=""
LOTSLARP_DISCORD_BOT_SMTP_USER=""
LOTSLARP_DISCORD_BOT_SMTP_PASSWORD=""

# Digest Recipient
LOTSLARP_DISCORD_BOT_DIGEST_RECIPIENT=""

# Database Path
# For Cloud Run, you might want to use a persistent volume, e.g., /mnt/db/huh.db
LOTSLARP_DISCORD_BOT_APP_DB="/app/huh.db"

# Summary Role ID
LOTSLARP_DISCORD_BOT_SUMMARY_ROLE_ID=""
